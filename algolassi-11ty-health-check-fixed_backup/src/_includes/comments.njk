{% set commentExcluded = [
  "/",
  "/197-2/",
  "/about-algolassi/",
  "/contact-algolassi/",
  "/disclaimer/",
  "/privacy-policy-2/",
  "/terms-conditions/",
  "/thank-you/",
  "/sample-page/",
  "/troubleshooting/",
  "/algolassi/"
] %}

{% if permalink not in commentExcluded %}
<section class="algolassi-comments" aria-labelledby="comments-title">
  <h2 id="comments-title">💬 Comments</h2>
  <p class="comments-intro">Sign in with Google to publish immediately, or comment anonymously and wait for approval.</p>

  <form id="algolassi-comment-form" class="comment-form">
    <label for="comment-name">Name</label>
    <input id="comment-name" name="name" type="text" maxlength="100" required autocomplete="name" placeholder="Your name">

    <label for="comment-text">Comment</label>
    <textarea id="comment-text" name="comment" maxlength="5000" rows="6" required placeholder="Write your comment..."></textarea>

    <button type="submit">Post Comment</button>
    <p id="comment-status" class="comment-status" role="status" aria-live="polite"></p>
  </form>

  <div id="algolassi-comment-list" class="comment-list" aria-live="polite">
    <p>Loading comments...</p>
  </div>
</section>

<style>
.algolassi-comments{max-width:820px;margin:48px auto 20px;padding:28px;border-top:1px solid #ddd}.algolassi-comments h2{margin-bottom:8px}.comments-intro{margin-bottom:24px;color:#666}.comment-form{display:grid;gap:9px;margin-bottom:34px}.comment-form input,.comment-form textarea{width:100%;box-sizing:border-box;padding:11px 12px;border:1px solid #ccc;border-radius:6px;font:inherit}.comment-form textarea{resize:vertical}.comment-form button{width:fit-content;padding:10px 18px;border:0;border-radius:6px;cursor:pointer;font:inherit}.comment-form button:disabled{opacity:.6;cursor:not-allowed}.comment-status{min-height:1.4em}.comment-item{padding:18px 0;border-top:1px solid #e5e5e5}.comment-author{font-weight:700}.comment-date{margin-left:8px;color:#777;font-size:.9em}.comment-body{margin-top:9px;white-space:pre-wrap;overflow-wrap:anywhere}
</style>

<script>
(function () {
  "use strict";

  window.AlgolassiCommentsInit = function () {
    var list = document.getElementById("algolassi-comment-list");
    var form = document.getElementById("algolassi-comment-form");
    var status = document.getElementById("comment-status");
    if (!list || !form || list.dataset.initialized === "true") return;
    list.dataset.initialized = "true";

    var SUPABASE_URL = "https://ashezapnoqslggtxcncj.supabase.co";
    var SUPABASE_KEY = "sb_publishable_ki4D3v_JZk4elETfkYtmGA_xWDtbpBg";
    var endpoint = SUPABASE_URL + "/rest/v1/comments";
    var pageSlug = window.location.pathname.replace(/^\\/+|\\/+$/g, "") || "home";
    var restHeaders = { apikey: SUPABASE_KEY, Authorization: "Bearer " + SUPABASE_KEY, "Content-Type": "application/json" };

    function escapeHtml(value) {
      return String(value).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/\"/g, "&quot;").replace(/'/g, "&#039;");
    }

    function getClient() { return window.AlgolassiSupabase || null; }

    async function getSession() {
      var client = getClient();
      if (!client) return null;
      var result = await client.auth.getSession();
      return result.data && result.data.session ? result.data.session : null;
    }

    async function loadComments() {
      try {
        var response = await fetch(endpoint + "?select=id,name,comment,created_at&approved=eq.true&page_slug=eq." + encodeURIComponent(pageSlug) + "&order=created_at.desc", { headers: restHeaders });
        if (!response.ok) throw new Error("Unable to load comments.");
        var comments = await response.json();
        if (!comments.length) { list.innerHTML = "<p>No comments yet. Be the first to comment!</p>"; return; }
        list.innerHTML = comments.map(function (item) {
          return '<article class="comment-item"><div><span class="comment-author">' + escapeHtml(item.name) + '</span><span class="comment-date">' + escapeHtml(new Date(item.created_at).toLocaleString()) + '</span></div><div class="comment-body">' + escapeHtml(item.comment) + '</div></article>';
        }).join("");
      } catch (error) {
        list.innerHTML = "<p>Comments are temporarily unavailable. Please try again later.</p>";
        console.error("Algolassi comments:", error);
      }
    }

    async function updateIdentity() {
      var session = await getSession();
      var user = session && session.user;
      if (user) {
        var metadata = user.user_metadata || {};
        var name = metadata.full_name || metadata.name || user.email || "Google user";
        document.getElementById("comment-name").value = name;
        document.getElementById("comment-name").readOnly = true;
        status.textContent = "✓ Signed in with Google. Your comment will be published immediately.";
      } else {
        document.getElementById("comment-name").readOnly = false;
        if (!status.textContent || status.textContent.indexOf("published") !== -1) status.textContent = "Anonymous comments are reviewed before publishing.";
      }
    }

    form.addEventListener("submit", async function (event) {
      event.preventDefault();
      var nameInput = document.getElementById("comment-name");
      var commentInput = document.getElementById("comment-text");
      var name = nameInput.value.trim();
      var comment = commentInput.value.trim();
      if (!name || !comment) { status.textContent = "Please enter your name and comment."; return; }

      var button = form.querySelector("button[type=submit]");
      button.disabled = true;
      status.textContent = "Posting comment...";

      try {
        var session = await getSession();
        var payload = { page_slug: pageSlug, name: name, comment: comment };
        var response;

        if (session && session.user && getClient()) {
          response = await getClient().from("comments").insert(payload);
        } else {
          response = await fetch(endpoint, {
            method: "POST",
            headers: Object.assign({}, restHeaders, { Prefer: "return=minimal" }),
            body: JSON.stringify(payload)
          });
          if (!response.ok) throw new Error(await response.text());
        }

        if (response && response.error) throw response.error;
        form.reset();
        await updateIdentity();
        var loggedIn = !!(session && session.user);
        status.textContent = loggedIn ? "Thanks! Your comment is now published." : "Thanks! Your comment was submitted and will appear after approval.";
        await loadComments();
      } catch (error) {
        status.textContent = "Sorry, your comment could not be submitted. Please try again.";
        console.error("Algolassi comment submit:", error);
      } finally {
        button.disabled = false;
      }
    });

    loadComments();
    updateIdentity();
    window.addEventListener("algolassi:auth-changed", updateIdentity);
  };

  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", window.AlgolassiCommentsInit);
  else window.AlgolassiCommentsInit();
})();
</script>
{% endif %}
