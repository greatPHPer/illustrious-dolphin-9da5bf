{% set commentExcluded = [
  "/",
  "/197-2/",
  "/about-algolassi/",
  "/contact-algolassi/",
  "/disclaimer/",
  "/privacy-policy-2/",
  "/terms-conditions/",
  "/thank-you/",
  "/sample-page/",
  "/troubleshooting/",
  "/algolassi/"
] %}

{% if permalink not in commentExcluded %}
<section class="algolassi-comments" aria-labelledby="comments-title">
  <h2 id="comments-title">💬 Comments</h2>
  <p class="comments-intro">Have a question, found an issue, or want to share something useful? Leave a comment below.</p>

  <form id="algolassi-comment-form" class="comment-form">
    <label for="comment-name">Name</label>
    <input id="comment-name" name="name" type="text" maxlength="100" required autocomplete="name" placeholder="Your name">

    <label for="comment-text">Comment</label>
    <textarea id="comment-text" name="comment" maxlength="5000" rows="6" required placeholder="Write your comment..."></textarea>

    <button type="submit">Post Comment</button>
    <p id="comment-status" class="comment-status" role="status" aria-live="polite"></p>
  </form>

  <div id="algolassi-comment-list" class="comment-list" aria-live="polite">
    <p>Loading comments...</p>
  </div>
</section>

<style>
.algolassi-comments {
  max-width: 820px;
  margin: 48px auto 20px;
  padding: 28px;
  border-top: 1px solid #ddd;
}
.algolassi-comments h2 { margin-bottom: 8px; }
.comments-intro { margin-bottom: 24px; color: #666; }
.comment-form { display: grid; gap: 9px; margin-bottom: 34px; }
.comment-form input,
.comment-form textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 11px 12px;
  border: 1px solid #ccc;
  border-radius: 6px;
  font: inherit;
}
.comment-form textarea { resize: vertical; }
.comment-form button {
  width: fit-content;
  padding: 10px 18px;
  border: 0;
  border-radius: 6px;
  cursor: pointer;
  font: inherit;
}
.comment-status { min-height: 1.4em; }
.comment-item {
  padding: 18px 0;
  border-top: 1px solid #e5e5e5;
}
.comment-author { font-weight: 700; }
.comment-date { margin-left: 8px; color: #777; font-size: .9em; }
.comment-body { margin-top: 9px; white-space: pre-wrap; overflow-wrap: anywhere; }
</style>

<script>
(function () {
  const SUPABASE_URL = "https://ashezapnoqslggtxcncj.supabase.co";
  const SUPABASE_KEY = "sb_publishable_ki4D3v_JZk4elETfkYtmGA_xWDtbpBg";
  const endpoint = SUPABASE_URL + "/rest/v1/comments";
  const pageSlug = window.location.pathname.replace(/^\/+|\/+$/g, "") || "home";

  const headers = {
    "apikey": SUPABASE_KEY,
    "Authorization": "Bearer " + SUPABASE_KEY,
    "Content-Type": "application/json"
  };

  const list = document.getElementById("algolassi-comment-list");
  const form = document.getElementById("algolassi-comment-form");
  const status = document.getElementById("comment-status");

  function escapeHtml(value) {
    return String(value)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  async function loadComments() {
    try {
      const response = await fetch(
        endpoint + "?select=id,name,comment,created_at&approved=eq.true&page_slug=eq." + encodeURIComponent(pageSlug) + "&order=created_at.desc",
        { headers }
      );

      if (!response.ok) throw new Error("Unable to load comments.");
      const comments = await response.json();

      if (!comments.length) {
        list.innerHTML = "<p>No comments yet. Be the first to comment!</p>";
        return;
      }

      list.innerHTML = comments.map(function (item) {
        const date = new Date(item.created_at).toLocaleString();
        return '<article class="comment-item">' +
          '<div><span class="comment-author">' + escapeHtml(item.name) + '</span>' +
          '<span class="comment-date">' + escapeHtml(date) + '</span></div>' +
          '<div class="comment-body">' + escapeHtml(item.comment) + '</div>' +
          '</article>';
      }).join("");
    } catch (error) {
      list.innerHTML = "<p>Comments are temporarily unavailable. Please try again later.</p>";
      console.error(error);
    }
  }

  form.addEventListener("submit", async function (event) {
    event.preventDefault();
    status.textContent = "Posting comment...";

    const name = document.getElementById("comment-name").value.trim();
    const comment = document.getElementById("comment-text").value.trim();

    if (!name || !comment) {
      status.textContent = "Please enter your name and comment.";
      return;
    }

    try {
      const response = await fetch(endpoint, {
        method: "POST",
        headers: Object.assign({}, headers, { "Prefer": "return=minimal" }),
        body: JSON.stringify({
          page_slug: pageSlug,
          name: name,
          comment: comment,
          approved: false
        })
      });

      if (!response.ok) {
        const detail = await response.text();
        console.error(detail);
        throw new Error("Unable to submit comment.");
      }

      form.reset();
      status.textContent = "Thanks! Your comment was submitted and will appear after approval.";
    } catch (error) {
      status.textContent = "Sorry, your comment could not be submitted. Please try again.";
      console.error(error);
    }
  });

  loadComments();
})();
</script>
{% endif %}
