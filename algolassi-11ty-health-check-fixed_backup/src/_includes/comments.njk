{% set commentExcluded = [
  "/",
  "/197-2/",
  "/about-algolassi/",
  "/contact-algolassi/",
  "/disclaimer/",
  "/privacy-policy-2/",
  "/terms-conditions/",
  "/thank-you/",
  "/sample-page/",
  "/troubleshooting/",
  "/algolassi/"
] %}

{% if permalink not in commentExcluded %}
<section class="algolassi-comments" aria-labelledby="comments-title">
  <h2 id="comments-title">💬 Comments</h2>
  <p class="comments-intro">Sign in with Google to publish immediately, or comment anonymously and wait for approval.</p>

  <form id="algolassi-comment-form" class="comment-form">
    <label for="comment-name">Name</label>
    <input id="comment-name" name="name" type="text" maxlength="100" required autocomplete="name" placeholder="Your name">

    <label for="comment-text">Comment</label>
    <textarea id="comment-text" name="comment" maxlength="5000" rows="6" required placeholder="Write your comment..."></textarea>

    <button type="submit">Post Comment</button>
    <p id="comment-status" class="comment-status" role="status" aria-live="polite"></p>
  </form>

  <div id="algolassi-comment-list" class="comment-list" aria-live="polite">
    <p>Loading comments...</p>
  </div>
</section>

<style>
.algolassi-comments{max-width:820px;margin:48px auto 20px;padding:28px;border-top:1px solid #ddd}.algolassi-comments h2{margin-bottom:8px}.comments-intro{margin-bottom:24px;color:#666}.comment-form{display:grid;gap:9px;margin-bottom:34px}.comment-form input,.comment-form textarea{width:100%;box-sizing:border-box;padding:11px 12px;border:1px solid #ccc;border-radius:6px;font:inherit}.comment-form textarea{resize:vertical}.comment-form button{width:fit-content;padding:10px 18px;border:0;border-radius:6px;cursor:pointer;font:inherit}.comment-form button:disabled{opacity:.6;cursor:not-allowed}.comment-status{min-height:1.4em}.comment-item{padding:18px 0;border-top:1px solid #e5e5e5}.comment-author{font-weight:700}.comment-date{margin-left:8px;color:#777;font-size:.9em}.comment-body{margin-top:9px;white-space:pre-wrap;overflow-wrap:anywhere}
</style>
{% endif %}
