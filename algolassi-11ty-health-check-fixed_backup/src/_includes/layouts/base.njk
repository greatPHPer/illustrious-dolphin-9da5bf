
<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">

  <meta name="viewport"
        content="width=device-width, initial-scale=1">

  <title>{{ title }} | Algolassi</title>

  {% if description %}
    <meta name="description"
          content="{{ description | escape }}">
  {% endif %}

  <meta name="generator"
        content="Eleventy">

  <link rel="icon"
        href="/wp-content/uploads/2025/09/cropped-algolassi_logo_icon-32x32.png">

  <link rel="stylesheet"
        href="/assets/css/site.css">

  <link rel="stylesheet"
        href="/assets/css/algolassi-assistant.css">

  {% if permalink %}
    <link rel="canonical"
          href="https://algolassi.online{{ permalink }}">
  {% endif %}
<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4185133949320759"
     crossorigin="anonymous"></script>
</head>

<body>

<header class="site-header">

  <div class="site-header-inner">

    <a class="brand"
       href="/">

      <img src="/wp-content/uploads/2025/09/cropped-algolassi_logo_icon-32x32.png"
           alt="Algolassi"
           width="32"
           height="32">

      <span>Algolassi</span>

    </a>

    <nav class="site-nav"
         aria-label="Main navigation">

      <a href="/tutorials/">Tutorials</a>

      <a href="/csharp-tutorials/">C#</a>

      <a href="/net-tutorials/">.NET</a>

      <a href="/asp-net-core-tutorials/">ASP.NET Core</a>

      <a href="/blazor-tutorials/">Blazor</a>

      <a href="/sql-server-tutorials/">SQL Server</a>

      <a href="/about-algolassi/">About</a>

    </nav>

  </div>

</header>


<main class="site-main">

  {# =====================================================
     ALGOLASSI BREADCRUMB
     Show on BOTH articles and normal/pillar pages
     ===================================================== #}

  {% include "components/breadcrumb.njk" %}


  {% if contentType == "post" %}

    <article class="article">

      <header class="article-header">

        <p class="eyebrow">
          ARTICLE
        </p>

        <h1>
          {{ title }}
        </h1>

        {% if date %}

          <time datetime="{{ date }}">
            {{ date | date("dd LLLL yyyy") }}
          </time>

        {% endif %}

      </header>


      <div class="article-content">

        {{ content | safe }}

      </div>


      {% include "comments.njk" %}

    </article>


  {% else %}

    <div class="page-content">

      {{ content | safe }}

      {% include "comments.njk" %}

    </div>

  {% endif %}

</main>


<footer class="site-footer">

  <div class="footer-inner">

    <div>

      <strong>Algolassi</strong>

      <p>
        Practical software development tutorials.
      </p>

    </div>


    <nav>

      <a href="/tutorials/">
        Tutorials
      </a>

      <a href="/197-2/">
        Portfolio
      </a>

      <a href="/about-algolassi/">
        About
      </a>

      <a href="/contact-algolassi/">
        Contact
      </a>

      <a href="/privacy-policy-2/">
        Privacy
      </a>

    </nav>

  </div>


  <p class="copyright">
    © {{ currentYear }} Algolassi. All rights reserved.
  </p>

</footer>

<script>
  // Optional: set this to a serverless news endpoint when one is available.
  // It is intentionally empty for now so the assistant never exposes an API key.
  window.ALGOLASSI_ASSISTANT_NEWS_ENDPOINT = "";
</script>
<script src="/assets/js/algolassi-assistant.js" defer></script>

</body>

</html>
