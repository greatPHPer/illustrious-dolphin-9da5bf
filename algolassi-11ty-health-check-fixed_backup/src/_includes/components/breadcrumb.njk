    📚 Tutorials
    <span class="breadcrumb-arrow">▼</span>

  </a>


  <div class="breadcrumb-menu"
       data-menu="tutorials">


    {% set tutorialDropdownItems = [

      {
        title: "💻 C# Tutorials",
        url: "/csharp-tutorials/"
      },

      {
        title: "🌐 .NET Tutorials",
        url: "/net-tutorials/"
      },

      {
        title: "⚡ ASP.NET Core Tutorials",
        url: "/asp-net-core-tutorials/"
      },

      {
        title: "🔥 Blazor Tutorials",
        url: "/blazor-tutorials/"
      },

      {
        title: "🛢️ SQL Server Tutorials",
        url: "/sql-server-tutorials/"
      },

      {
        title: "📱 .NET MAUI Tutorials",
        url: "/net-maui-tutorials/"
      }

    ] %}


    {% for item in tutorialDropdownItems %}

      {% set isActive = false %}


