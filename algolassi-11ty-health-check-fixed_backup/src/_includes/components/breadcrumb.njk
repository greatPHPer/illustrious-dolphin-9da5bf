{# =====================================================
   HOME DROPDOWN
   ===================================================== #}

<div class="breadcrumb-dropdown">

  <a href="/"
     class="breadcrumb-trigger crumb-trigger"
     data-menu="home">

    🏠 Home
    <span class="breadcrumb-arrow">▼</span>

  </a>


  <div class="breadcrumb-menu"
       data-menu="home">

    {% set homeDropdownItems = [

      {
        title: "📚 Tutorials",
        url: "/tutorials/"
      },

      {
        title: "ℹ️ About",
        url: "/about-algolassi/"
      }

    ] %}


    {% for item in homeDropdownItems %}

      {% set isActive = false %}


      {# -------------------------------------------------
         HOME → TUTORIALS
         ------------------------------------------------- #}

      {% if item.url == "/tutorials/" %}

        {% if page.url == "/tutorials/"
           or page.url == "/csharp-tutorials/"
           or page.url == "/net-tutorials/"
           or page.url == "/asp-net-core-tutorials/"
           or page.url == "/blazor-tutorials/"
           or page.url == "/sql-server-tutorials/"
           or page.url == "/net-maui-tutorials/"
           or isCSharpArticle
           or isNetArticle
           or isAspNetCoreArticle
           or isBlazorArticle
           or isSqlArticle
           or isMauiArticle %}

          {% set isActive = true %}

        {% endif %}


      {# -------------------------------------------------
         HOME → ABOUT
         ------------------------------------------------- #}

      {% elif item.url == "/about-algolassi/" %}

        {% if page.url == "/about-algolassi/" %}

          {% set isActive = true %}

        {% endif %}

      {% endif %}


      <a href="{{ item.url }}"
         class="{% if isActive %}breadcrumb-dropdown-current{% endif %}">

        {{ item.title }}

      </a>

    {% endfor %}

  </div>

</div>


<span class="breadcrumb-separator">/</span>



{# =====================================================
   TUTORIALS DROPDOWN
   ===================================================== #}

<div class="breadcrumb-dropdown">

