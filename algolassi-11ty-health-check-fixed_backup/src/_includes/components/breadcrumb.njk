           or isNetArticle %}

          {% set isActive = true %}

        {% endif %}


      {# =================================================
         ASP.NET CORE PILLAR
         ================================================= #}

      {% elif item.url == "/asp-net-core-tutorials/" %}

        {% if page.url == "/asp-net-core-tutorials/"
           or isAspNetCoreArticle %}

          {% set isActive = true %}

        {% endif %}


      {# =================================================
         BLAZOR PILLAR
         ================================================= #}

      {% elif item.url == "/blazor-tutorials/" %}

        {% if page.url == "/blazor-tutorials/"
           or isBlazorArticle %}

          {% set isActive = true %}

        {% endif %}


      {# =================================================
         SQL SERVER PILLAR
         ================================================= #}

      {% elif item.url == "/sql-server-tutorials/" %}

        {% if page.url == "/sql-server-tutorials/"
           or isSqlArticle %}

          {% set isActive = true %}

        {% endif %}


      {# =================================================
         .NET MAUI PILLAR
         ================================================= #}

      {% elif item.url == "/net-maui-tutorials/" %}

        {% if page.url == "/net-maui-tutorials/"
           or isMauiArticle %}

          {% set isActive = true %}

        {% endif %}

      {% endif %}


      <a href="{{ item.url }}"
         class="{% if isActive %}breadcrumb-dropdown-current{% endif %}">

        {{ item.title }}

      </a>

    {% endfor %}

  </div>

</div>


<span class="breadcrumb-separator">/</span>



