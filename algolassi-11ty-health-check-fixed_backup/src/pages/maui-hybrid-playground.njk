<div class="maui-playground" id="maui-playground">
  <header class="maui-playground-header">
    <div>
      <p class="eyebrow">ONLINE TOOL</p>
      <h1>MAUI Hybrid Web Playground</h1>
      <p>Edit a complete MAUI Hybrid-style solution and preview the web-compatible portion directly in your browser.</p>
    </div>
    <button type="button" class="maui-create-project" id="maui-create-project">Create Project</button>
  </header>

  <div class="maui-playground-grid">
    <aside class="maui-project-explorer" aria-label="Solution Explorer">
      <div class="maui-panel-title">SOLUTION EXPLORER</div>
      <div class="maui-solution-name">📁 MyMauiApp</div>
      <ol class="maui-project-tree">
        <li><button type="button" class="maui-tree-project active">📁 <span>1. MyMauiApp</span></button></li>
        <li><button type="button" class="maui-tree-project">📁 <span>2. MyMauiApp.Shared</span></button></li>
        <li><button type="button" class="maui-tree-project">📁 <span>3. MyMauiApp.Web</span></button></li>
        <li><button type="button" class="maui-tree-project">📁 <span>4. MyMauiApp.Web.Client</span></button></li>
      </ol>
      <p class="maui-tree-note">The solution is intentionally ordered MAUI → Shared → Web → Web Client.</p>
    </aside>

    <section class="maui-code-panel">
      <div class="maui-panel-title">EDITOR</div>
      <div class="maui-file-tabs" id="maui-editor-tabs"></div>
      <textarea id="maui-code-editor" spellcheck="false"></textarea>
    </section>

    <section class="maui-preview-panel">
      <div class="maui-panel-title">WEB PREVIEW <button type="button" id="maui-run-preview">▶ Run</button></div>
      <div class="maui-browser-frame" id="maui-browser-preview">
        <div class="maui-browser-toolbar"><span>●</span><span>●</span><span>●</span><code>https://preview.algolassi.local/</code></div>
        <div class="maui-browser-content">
          <h2>Hello from MAUI Hybrid!</h2>
          <p>This is the browser preview area.</p>
          <button type="button" id="maui-demo-button">Click Me</button>
          <p id="maui-demo-output" class="maui-demo-output"></p>
        </div>
      </div>
    </section>
  </div>

  <div class="maui-console"><div class="maui-panel-title">CONSOLE</div><pre id="maui-console-output">Ready. Create a project or edit the sample files.</pre></div>
  <p class="maui-playground-note"><strong>Browser preview:</strong> the complete solution tree is available for learning and editing. Native Android/iOS/Windows MAUI APIs are not executed in this web-only preview.</p>
</div>

